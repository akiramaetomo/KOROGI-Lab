{
  "name": "korogi-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --base=/KOROGI-Lab/",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run src",
    "test:browser": "playwright test",
    "test:pages": "node tests/pages-artifact-smoke.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.0",
    "vitest": "^5.0.1"
  }
}
